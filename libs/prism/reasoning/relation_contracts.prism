# Nominal epistemic state. Proposition P and exact Status remain type indices.
type ClaimId:
    sequence: Nat

type Boundary:
    | GlobalBoundary
    | NamedBoundary(name: String)

type Scope:
    boundaries: Set[Boundary]

type SourceId:
    sequence: Nat

type Provenance:
    sources: Set[SourceId]

type Taint:
    | AssumptionTaint(subject: ClaimId)
    | DomainTaint(subject: ClaimId)
    | SamplingTaint(subject: ClaimId)
    | ModelTaint(subject: ClaimId)

type Obligation[Subject, Discharge]:
    subject: Subject
    required: Discharge

type Judgment[P, Status]:
    status: Status
    identity: ClaimId
    scope: Scope
    provenance: Provenance
    taints: Set[Taint]
    obligations: Set[Obligation[ClaimId, Status]]

# Abstract obligations name the exact state change; no domain witnesses are supplied.
def IdentityIsPreserved[Before, After](before: Before, after: After) -> Prop
def RevisionLinksPredecessor[Before, After](before: Before, after: After) -> Prop
def ScopeIsContained[Before, After](before: Before, after: After) -> Prop
def SourcesRemainReachable[Before, After](before: Before, after: After) -> Prop
def TaintIsDischarged(taint: Taint) -> Prop
def AssuranceIsPreserved[Before, After](before: Before, after: After) -> Prop
def AssuranceIsAuthorized[Before, After](before: Before, after: After, policy: ClaimId) -> Prop
def ObligationIsDischarged[Subject, Discharge](obligation: Obligation[Subject, Discharge]) -> Prop
def StateIsEqual[State](before: State, after: State) -> Prop

type IdentityChange[Before, After]:
    | IdentityPreserved(
        before: Before,
        after: After,
        proof: Proof[IdentityIsPreserved(before, after)]
    )
    | IdentityRevised(
        before: Before,
        after: After,
        proof: Proof[RevisionLinksPredecessor(before, after)]
    )

type ScopeChange[Before, After]:
    before: Before
    after: After
    containment: Proof[ScopeIsContained(before, after)]

type ProvenanceChange[Before, After]:
    before: Before
    after: After
    reachability: Proof[SourcesRemainReachable(before, after)]

type TaintDischarge:
    taint: Taint
    discharge: Proof[TaintIsDischarged(taint)]

type TaintChange[Before, After]:
    before: Before
    after: After
    discharges: Set[TaintDischarge]

type AssuranceChange[Before, After]:
    | AssurancePreserved(
        before: Before,
        after: After,
        proof: Proof[AssuranceIsPreserved(before, after)]
    )
    | AssuranceIntroduced(
        before: Before,
        after: After,
        policy: ClaimId,
        proof: Proof[AssuranceIsAuthorized(before, after, policy)]
    )

type ObligationDischarge[Subject, Discharge]:
    obligation: Obligation[Subject, Discharge]
    proof: Proof[ObligationIsDischarged(obligation)]

type ObligationChange[Before, After, Subject, Discharge]:
    before: Before
    after: After
    discharges: Set[ObligationDischarge[Subject, Discharge]]

type StateConservation[Before, After, Subject, Discharge]:
    identity: IdentityChange[Before, After]
    scope: ScopeChange[Before, After]
    provenance: ProvenanceChange[Before, After]
    taints: TaintChange[Before, After]
    assurance: AssuranceChange[Before, After]
    obligations: ObligationChange[Before, After, Subject, Discharge]

type ExactPreservation[State]:
    before: State
    after: State
    proof: Proof[StateIsEqual(before, after)]

type JoinCertificate[Left, Right, Joined]:
    left: Left
    right: Right
    joined: Joined
    left_conservation: StateConservation[Left, Joined, ClaimId, Unit]
    right_conservation: StateConservation[Right, Joined, ClaimId, Unit]

type JoinError:
    | IdentityConflict(left: ClaimId, right: ClaimId)
    | EmptyScopeIntersection(scope: Scope)
    | IncompatibleStatus(identity: ClaimId)
