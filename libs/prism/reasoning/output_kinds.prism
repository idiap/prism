from prism.reasoning.relation_contracts import (
    ClaimId,
    Judgment,
    SourceId,
)

type KnowledgeNode[Schema]:
    value: Schema
    identity: ClaimId

type KnowledgeEdge:
    source: ClaimId
    target: ClaimId

type KnowledgeBase[Schema, Version]:
    version: Version
    nodes: Set[KnowledgeNode[Schema]]
    edges: Set[KnowledgeEdge]

type KnowledgeSuccessor[Before, After]:
    before: Before
    after: After
    retained_sources: Set[SourceId]

type CalibrationDisposition:
    | Conserve
    | Demote
    | Promote
    | Quarantine
    | Gate
    | Accept
    | Stop
    | AuthorizeHandoff

type EpistemicDisposition:
    | Continue
    | Reject
    | Defer
    | Route

type EpistemicDecision[Subjects]:
    subjects: Subjects
    disposition: EpistemicDisposition

type CalibrationDecision[Subjects]:
    subjects: Subjects
    disposition: CalibrationDisposition
    policy: ClaimId
    policy_authorization: Proof[CalibrationIsAuthorized(subjects, disposition, policy)]
    no_new_claim: Proof[CalibrationCreatesNoClaim(subjects, disposition)]
    no_new_evidence: Proof[CalibrationCreatesNoEvidence(subjects, disposition)]

def CalibrationIsAuthorized[Subjects](subjects: Subjects, disposition: CalibrationDisposition, policy: ClaimId) -> Prop
def CalibrationCreatesNoClaim[Subjects](subjects: Subjects, disposition: CalibrationDisposition) -> Prop
def CalibrationCreatesNoEvidence[Subjects](subjects: Subjects, disposition: CalibrationDisposition) -> Prop

type ModelAssumption:
    identity: ClaimId

type ModelParameter:
    identity: ClaimId

type ErrorBound:
    magnitude: Decimal

type IdealizationMap[System]:
    system: System
    assumptions: Set[ModelAssumption]

type ModelArtifact[System, ModelScope]:
    system: System
    scope: ModelScope
    assumptions: Set[ModelAssumption]
    parameters: Set[ModelParameter]
    error_bounds: Set[ErrorBound]
    idealization: IdealizationMap[System]

type ReasoningPlan[Objective, Step]:
    objective: Objective
    steps: List[Step]

type Presentation[Sources]:
    sources: Sources
    authority: ZeroAuthority

type ZeroAuthority:
    | ProjectionOnly

type Bundle[Components]:
    components: Components

type Unavailable[Expected]:
    expected: Expected
    reason: UnavailableReason

type UnavailableReason:
    | UnresolvedProjection
    | MissingMaterialization
    | ClosedKnowledgeBoundary

type KnowledgeAdmission[Proposal, Schema, Version]:
    proposal: Proposal
    target: KnowledgeBase[Schema, Version]
    policy: ClaimId
    authorization: Proof[KnowledgeAdmissionIsAuthorized(proposal, target, policy)]

def KnowledgeAdmissionIsAuthorized[Proposal, Schema, Version](proposal: Proposal, target: KnowledgeBase[Schema, Version], policy: ClaimId) -> Prop

# Semantic ports are nominal or assurance-preserving aliases, never artifact labels.
type Observation[Value] = Evidence[Value]
type Witness[Value] = Evidence[Value]
type Candidate[P, Status] = Judgment[P, Status]
type Premise[P, Status] = Judgment[P, Status]
type Calibrated[Subjects] = CalibrationDecision[Subjects]
type EpistemicAssessment[Subjects] = EpistemicDecision[Subjects]

type Delta[Before, After]:
    before: Before
    after: After
