type ContrastInput[Baseline, Alternative]:
    baseline: Baseline
    alternative: Alternative

type Contrastive[Conclusion, Baseline, Alternative] = (
    source: ContrastInput[Baseline, Alternative],
) -> Conclusion with:
    taxonomy = "prism-workflow-component-taxonomy@0.6.0"
    primary_family = core_reasoning
    reasoning_archetypes = [contrastive]
