type RefutationInput[Subject, Search]:
    subject: Subject
    search: Search

type Refutational[Conclusion, Subject, Search] = (
    source: RefutationInput[Subject, Search],
) -> Conclusion with:
    taxonomy = "prism-workflow-component-taxonomy@0.6.0"
    primary_family = evaluation_and_judgment
    reasoning_archetypes = [refutational]
