type AnalogicalInput[SourceValue, TargetValue, CorrespondenceValue]:
    source: SourceValue
    target: TargetValue
    correspondence: CorrespondenceValue

type Analogical[Conclusion, SourceValue, TargetValue, CorrespondenceValue] = (
    source: AnalogicalInput[SourceValue, TargetValue, CorrespondenceValue],
) -> Conclusion
