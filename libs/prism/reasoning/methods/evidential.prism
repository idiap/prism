type EvidentialInput[Observations, Criteria]:
    observations: Observations
    criteria: Criteria

type Evidential[Conclusion, Observations, Criteria] = (
    source: EvidentialInput[Observations, Criteria],
) -> Conclusion with:
    taxonomy = "prism-workflow-component-taxonomy@0.6.0"
    primary_family = evaluation_and_judgment
    reasoning_archetypes = [evidential_assessment]
