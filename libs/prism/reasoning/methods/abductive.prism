type AbductionInput[Background, Observation]:
    background: Background
    observation: Observation

type AbductionProtocol[Background, Hypothesis, Observation] = (
    background: Background,
    hypothesis: Hypothesis,
    observation: Observation,
) -> Prop

type Abductive[Hypothesis, Background, Observation] = (
    source: AbductionInput[Background, Observation],
) -> Hypothesis
