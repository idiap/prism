type DeductionInput[Premises]:
    context: Premises

def Entails[Premises, Proposition](
    context: Premises,
    conclusion: Proposition,
) -> Prop

type Deductive[Conclusion, Premises] = (
    source: DeductionInput[Premises],
) -> Conclusion

type ProvenDeductive[Conclusion, Premises, Accepted] = (
    source: DeductionInput[Validated[value: Premises, Accepted]],
) -> Verified[value: Conclusion, Entails(source.context.value, value)]
