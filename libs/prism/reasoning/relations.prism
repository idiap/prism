from prism.reasoning.relation_contracts import ExactPreservation, StateIsEqual

# Endpoint descriptions carry no assurance. Certifying relations name an exact claim.
type Required[Before, After]:
    source: Before
    target: After

type Assumed[Before, After]:
    source: Before
    target: After

type Tested[Before, After]:
    source: Before
    target: After

type CalibratedRelation[Before, After]:
    source: Before
    target: After

type Transferred[Before, After]:
    source: Before
    target: After

type Probed[Before, After]:
    source: Before
    target: After

type Preserved[State, Equality]:
    source: ExactPreservation[State]
    target: ExactPreservation[State]
    equality: Proof[Equality]

relation Requires[Before, After](
    source: Before,
    target: After,
) -> Required[Before, After]

relation Assume[Before, After](
    source: Before,
    target: After,
) -> Assumed[Before, After]

relation Test[Before, After](
    source: Before,
    target: After,
) -> Tested[Before, After]

relation Calibrate[Before, After](
    source: Before,
    target: After,
) -> CalibratedRelation[Before, After]

relation Transfer[Before, After](
    source: Before,
    target: After,
) -> Transferred[Before, After]

relation Probe[Before, After](
    source: Before,
    target: After,
) -> Probed[Before, After]

relation Preserve[State](
    source: ExactPreservation[State],
    target: ExactPreservation[State],
) -> Preserved[State, StateIsEqual(source.after, target.after)]
