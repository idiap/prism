type ReleaseCandidate:
    tests_passed: Bool
    approved: Bool

def ready(candidate: ReleaseCandidate) -> Bool:
    return candidate.tests_passed and candidate.approved

candidate = ReleaseCandidate(tests_passed = True, approved = True)

def main() -> Bool:
    return ready(candidate)
