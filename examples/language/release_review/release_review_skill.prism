from examples.language.release_review.reasoning import ReviewTask

release_review_skill: Skill[ReviewTask] = skill_artifact[ReviewTask](
    "release-review",
    "1.0.0",
    "release-review",
    "Review a proposed change against its release policy using the supplied summary and diff.",
    "# Release review\n\nReturn a structured `Review` for the supplied `ReviewTask`.\n\n- Inspect `observations.summary` and `observations.diff` for release risks.\n- Summarize the relevant changes, risks, and missing evidence in `summary`.\n- Use a nonnegative integer `risk`; values above `criteria.maximum_risk` exceed the policy.\n- Set `tests_passed` to true only when the supplied observations explicitly report passing tests. Otherwise return false and explain the missing test evidence.\n- Treat reported test results as supplied assertions. Do not claim to have executed tests or formally verified the change.\n- Leave the final approval decision to the release policy function.",
    "{}",
)
