from prism.reasoning.methods.deductive import DeductionInput, Deductive

deployed: Nat = 7
approved: Nat = 7

def SameVersion(left: Nat, right: Nat) -> Prop:
    return left == right

relation ApprovesRelease(
    source: DeductionInput[Proof[SameVersion(deployed, approved)]],
    target: Nat,
) |- SameVersion(deployed, approved)

reasoning ReleaseApproval(
    source: DeductionInput[Proof[SameVersion(deployed, approved)]],
) -> Nat:
    [version: Deductive[
        Nat,
        Proof[SameVersion(deployed, approved)],
    ](source)] by ApprovesRelease
    return version
