from examples.language.strict_inference.materialization import release_approval
from examples.language.strict_inference.reasoning import (
    SameVersion,
    ReleaseApproval,
    approved,
    deployed,
)
from prism.reasoning.methods.deductive import DeductionInput

def main() -> Result[Nat, ProofError]:
    term = try elaborate_proof[SameVersion(deployed, approved)]("rfl")
    proof = try kernel.check(term)
    source = DeductionInput(context = proof)
    flow = release_approval(source)
    result = solve ReleaseApproval(source) using flow
    return Ok(result)
